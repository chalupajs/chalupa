{
	"name": "@chalupajs/interface",
	"version": "1.7.0",
	"description": "Service framework",
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"clean": "rimraf ./dist ./coverage ./generated-docs ./junit.xml",
		"compile": "tsc -p tsconfig.build.json",
		"compile:watch": "tsc -p tsconfig.build.json --watch",
		"docs": "typedoc --out generated-docs src",
		"test": "jest --coverage",
		"lint": "eslint ./src",
		"lint:fix": "eslint ./src --fix",
		"prepublishOnly": "pnpm run clean && pnpm run compile"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:chalupajs/chalupa.git"
	},
	"license": "MIT",
	"devDependencies": {
		"@dwmt/eslint-config": "1.0.0",
		"@types/convict": "6.1.6",
		"@types/js-yaml": "4.0.9",
		"@types/uuid": "11.0.0",
		"eslint": "9.39.1",
		"prettier": "3.7.3",
		"rimraf": "6.1.2",
		"ts-node": "10.9.2",
		"typedoc": "0.28.15",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@inversifyjs/container": "^1.14.1",
		"@inversifyjs/core": "^9.1.1",
		"inversify": "7.10.4",
		"js-yaml": "4.1.1",
		"konvenient": "3.1.0",
		"reflect-metadata": "0.2.2",
		"uuid": "13.0.0"
	}
}
